# SemanticSQL Agent Environment Variables
# Copy this file to .env and update with your actual values

# ========================================
# LLM Configuration
# ========================================
# Model name (e.g., gpt-4, gpt-3.5-turbo, Qwen3-14B)
LLM_MODEL=Qwen3-14B

# API base URL (OpenAI compatible endpoint)
LLM_BASE_URL=http://localhost:9009/v1

# API key (use 'not-needed' for local models)
LLM_API_KEY=not-needed

# Temperature for generation (0.0-1.0)
LLM_TEMPERATURE=0.1

# Max tokens for response
LLM_MAX_TOKENS=6000

# Request timeout in seconds
LLM_TIMEOUT=30

# ========================================
# Database Configuration
# ========================================
# Database type: mysql, postgresql, sqlite
DB_TYPE=mysql

# Database connection details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ========================================
# Agent Configuration
# ========================================
# Maximum steps for ReAct loop
AGENT_MAX_STEPS=30

# Enable reflection mechanism
AGENT_ENABLE_REFLECTION=true

# Default generation count
AGENT_DEFAULT_COUNT=100

# ========================================
# Application Settings
# ========================================
# Environment: development, staging, production
APP_ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# Output directory for generated data
OUTPUT_DIR=output

# Cache directory
CACHE_DIR=.cache

# ========================================
# Performance Settings
# ========================================
# Batch size for bulk operations
BATCH_SIZE=10

# SQL execution timeout (seconds)
SQL_EXECUTION_TIMEOUT=30

# Maximum result rows
MAX_RESULT_ROWS=1000

# Cache TTL (seconds)
CACHE_TTL=3600

# ========================================
# Security Settings
# ========================================
# Enable SQL injection protection
ENABLE_SQL_PROTECTION=true

# Enable sensitive data masking
ENABLE_DATA_MASKING=false

# Allowed SQL operations (comma-separated)
ALLOWED_SQL_OPERATIONS=SELECT,INSERT,UPDATE

# ========================================
# Optional: External Services
# ========================================
# Redis configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Monitoring service
MONITORING_ENABLED=false
MONITORING_ENDPOINT=

# ========================================
# Development Settings
# ========================================
# Enable debug mode
DEBUG=false

# Enable SQL echo (show SQL queries)
SQL_ECHO=false

# Enable execution tracking
ENABLE_TRACKING=true

# Save execution traces to file
SAVE_TRACES=true