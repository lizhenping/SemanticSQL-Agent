# SemanticSQL Agent 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==================== 数据库配置 ====================
# 数据库类型：mysql, postgresql, sqlite
DB_TYPE=mysql

# 数据库连接信息
DB_HOST=192.168.200.216
DB_PORT=13306
DB_NAME=testdb
DB_USER=testuser
DB_PASSWORD=testpass

# 可选：数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_CONNECTION_TIMEOUT=30

# ==================== LLM 配置 ====================
# 模型名称
LLM_MODEL=Qwen3-14B

# API配置
LLM_BASE_URL=http://192.168.200.216:9991/v1
LLM_API_KEY=not-needed

# 生成参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=20000
LLM_TOP_P=0.9
LLM_TIMEOUT=30

# ==================== 应用配置 ====================
# 环境：development, testing, production
APP_ENV=development

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 调试模式
DEBUG=false

# ==================== 生成配置 ====================
# 默认生成数量
GENERATION_COUNT=100

# 批处理大小
GENERATION_BATCH_SIZE=10

# 质量控制
MIN_QUALITY_SCORE=70
ENABLE_VALIDATION=true
ENABLE_EXECUTION_TEST=false

# ==================== 输出配置 ====================
# 输出目录
OUTPUT_DIR=./output

# 默认输出格式：json, jsonl, csv, openai, huggingface
OUTPUT_FORMAT=json

# ==================== 性能配置 ====================
# 并行工作线程数
PARALLEL_WORKERS=4

# 全局超时（秒）
GLOBAL_TIMEOUT=300

# 内存限制（MB）
MEMORY_LIMIT=2048

# ==================== 代理配置（可选） ====================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ==================== 其他配置 ====================
# 缓存配置
ENABLE_CACHE=true
CACHE_TTL=3600

# 轨迹保存
SAVE_TRAJECTORY=true
TRAJECTORY_DIR=./trajectories

# 提示词优化
ENABLE_PROMPT_OPTIMIZATION=true