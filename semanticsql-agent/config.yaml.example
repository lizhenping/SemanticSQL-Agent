# SemanticSQL Agent 配置文件示例

# 模型配置
model:
  # 使用 OpenAI
  # name: "gpt-4"
  # provider: "openai"
  # api_key: "${OPENAI_API_KEY}"
  # base_url: "https://api.openai.com/v1"
  
  # 使用本地 vLLM
  name: "Qwen3-14B"
  provider: "openai"  # vLLM 兼容 OpenAI API
  base_url: "http://localhost:8000/v1"
  api_key: "not-needed"
  
  # 使用 Anthropic Claude
  # name: "claude-3-opus-20240229"
  # provider: "anthropic"
  # api_key: "${ANTHROPIC_API_KEY}"
  
  temperature: 0.1
  max_tokens: 2000

# 数据库配置
database:
  host: "localhost"
  port: 3306
  user: "root"
  password: "your_password"
  database: "your_database"
  charset: "utf8mb4"
  
  # 连接池配置（可选）
  pool_size: 5
  max_overflow: 10
  pool_timeout: 30
  pool_recycle: 3600

# 智能体配置
agent:
  max_iterations: 15
  enable_thinking: true  # 是否启用深度思考工具
  verbose: true         # 是否显示详细输出

# 日志配置
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  file: null     # 日志文件路径，null 表示不保存到文件